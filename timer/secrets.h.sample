#define WIFI_SSID "your_wifi_ssid"
#define WIFI_PW "your_wifi_password"
#define OTA_PW "your_ota_password"

// MQTT configuration (optional)
// Set MQTT_BROKER_ADDR to 0.0.0.0 to fully disable MQTT at runtime.
// Any non-zero IP enables MQTT and connects to the broker.
#define MQTT_BROKER_ADDR IPAddress(0, 0, 0, 0)  // Your MQTT broker IP, 0.0.0.0 = disabled
#define MQTT_BROKER_PORT 1883
#define MQTT_USERNAME ""  // Optional: set username if broker requires auth
#define MQTT_PASSWORD ""  // Optional: set password if broker requires auth
#define MQTT_PREFIX "homeassistant"  // MQTT topic prefix
